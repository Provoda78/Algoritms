{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build MPI task_Pi",
            "type": "shell",
            "command": "mpicxx",
            "args": [
                "-O2",
                "${workspaceFolder}/Multiplex/task_Pi.cpp",
                "-o",
                "${workspaceFolder}/Multiplex/task_Pi"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Multiplex"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Run MPI task_Pi",
            "type": "shell",
            "command": "mpirun",
            "args": [
                "-np",
                "2",
                "${workspaceFolder}/Multiplex/task_Pi"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Multiplex"
            },
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: mpicxx build active file",
            "command": "/usr/bin/mpicxx",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}